    {
      "name": "SchemaTest",
      "item": [
        {
          "name": "SchemaGet",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const schema = ",
                  "    {",
                  "  \"$schema\": \"http://json-schema.org/draft-07/schema#\",",
                  "  \"title\": \"Generated schema for Root\",",
                  "  \"type\": \"array\",",
                  "  \"items\": {",
                  "    \"type\": \"object\",",
                  "    \"properties\": {",
                  "      \"id\": {",
                  "        \"type\": \"number\"",
                  "      },",
                  "      \"title\": {",
                  "        \"type\": \"string\"",
                  "      },",
                  "      \"slug\": {",
                  "        \"type\": \"string\"",
                  "      },",
                  "      \"price\": {",
                  "        \"type\": \"number\"",
                  "      },",
                  "      \"description\": {",
                  "        \"type\": \"string\"",
                  "      },",
                  "      \"category\": {",
                  "        \"type\": \"object\",",
                  "        \"properties\": {",
                  "          \"id\": {",
                  "            \"type\": \"number\"",
                  "          },",
                  "          \"name\": {",
                  "            \"type\": \"string\"",
                  "          },",
                  "          \"slug\": {",
                  "            \"type\": \"string\"",
                  "          },",
                  "          \"image\": {",
                  "            \"type\": \"string\"",
                  "          },",
                  "          \"creationAt\": {",
                  "            \"type\": \"string\"",
                  "          },",
                  "          \"updatedAt\": {",
                  "            \"type\": \"string\"",
                  "          }",
                  "        },",
                  "        \"required\": [",
                  "          \"id\",",
                  "          \"name\",",
                  "          \"slug\",",
                  "          \"image\",",
                  "          \"creationAt\",",
                  "          \"updatedAt\"",
                  "        ]",
                  "      },",
                  "      \"images\": {",
                  "        \"type\": \"array\",",
                  "        \"items\": {",
                  "          \"type\": \"string\"",
                  "        }",
                  "      },",
                  "      \"creationAt\": {",
                  "        \"type\": \"string\"",
                  "      },",
                  "      \"updatedAt\": {",
                  "        \"type\": \"string\"",
                  "      }",
                  "    },",
                  "    \"required\": [",
                  "      \"id\",",
                  "      \"title\",",
                  "      \"slug\",",
                  "      \"price\",",
                  "      \"description\",",
                  "      \"category\",",
                  "      \"images\",",
                  "      \"creationAt\",",
                  "      \"updatedAt\"",
                  "    ]",
                  "  }",
                  "}",
                  "",
                  "pm.test(\"Response body has valid schema\", function () {",
                  "    pm.response.to.have.jsonSchema(schema);",
                  "})",
                  "",
                  "const responseBody = pm.response.json();",
                  "",
                  "",
                  "pm.test(\"All products have valid fields\", function() {",
                  "    for (let i = 0; i < responseBody.length; i++) {",
                  "        const product = responseBody[i];",
                  "        pm.expect(product).to.have.property('id');",
                  "        pm.expect(product).to.have.property('title');",
                  "        pm.expect(product).to.have.property('price');",
                  "        pm.expect(product).to.have.property('slug');",
                  "        pm.expect(product).to.have.property('description');",
                  "        pm.expect(product).to.have.property('images');",
                  "        pm.expect(product).to.have.property('category');",
                  "        ",
                  "        pm.expect(product.id).to.be.a('number');",
                  "        pm.expect(product.title).to.be.a('string');",
                  "        pm.expect(product.price).to.be.a('number');",
                  "        pm.expect(product.slug).to.be.a('string');",
                  "        pm.expect(product.description).to.be.a('string');",
                  "        pm.expect(product.images).to.be.an('array');",
                  "        pm.expect(product.category).to.be.an('object');",
                  "",
                  "        console.log(`✅ Product ${i + 1} passed: ID=${product.id}, Title=${product.title}, Price=${product.price}`);",
                  "    }",
                  "});",
                  "",
                  "",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
