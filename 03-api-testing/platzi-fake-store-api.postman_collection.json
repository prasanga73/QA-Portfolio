        {
          "listen": "test",
          "script": {
            "exec": [
              "const responseBody = pm.response.json();",
              "",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response time is less than 3500ms\",function(){",
              "    pm.expect(pm.response.responseTime).to.be.below(3500);",
              "});",
              "",
              "pm.test(\"Status code is 200\",function(){",
              "    pm.expect(pm.response.code).to.eql(200);",
              "    });",
              "",
              "const randomIndex = Math.floor(Math.random() * responseBody.length);",
              "const randomProduct = responseBody[randomIndex];",
              "",
              "const randomId = randomProduct.id;",
              "",
              "pm.collectionVariables.set(\"RandomId\", randomId);",
              "",
              "pm.collectionVariables.set(\"RandomSlug\",randomProduct.slug);",
              "",
              "",
              "console.log(\"Random Slug set to: \",randomProduct.slug,\"for id: \",randomId);",
              "",
              "pm.test(\"All products have valid fields\", function() {",
              "    for (let i = 0; i < responseBody.length; i++) {",
              "        const product = responseBo",
              "        pm.expect(product).to.have.property('id');",
              "        pm.expect(product).to.have.property('title');",
              "        pm.expect(product).to.have.property('price');",
              "        ",
              "        pm.expect(product.id).to.be.a('number');",
              "        pm.expect(product.title).to.be.a('string');",
              "        pm.expect(product.price).to.be.a('number');",
              "",
              "        console.log(`✅ Product ${i + 1} passed: ID=${product.id}, Title=${product.title}, Price=${product.price}`);",
              "    }",
              "});"
